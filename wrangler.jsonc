{
	"$schema": "./node_modules/wrangler/config-schema.json",
	// Rename per site: becomes <name>.<account>.workers.dev
	"name": "starter-static",
	"main": "worker/index.js",
	"compatibility_date": "2025-11-01",

	// Static site = Vite's dist/. Only /api/* runs Worker code; everything else is served
	// directly from Cloudflare's edge cache with the rules in dist/_headers.
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"html_handling": "auto-trailing-slash", // /about serves about.html
		"not_found_handling": "404-page", // serves dist/404.html with a 404 status
		"run_worker_first": ["/api/*"]
	},

	"observability": { "enabled": true },

	// Non-secret settings. Secrets: `wrangler secret put NAME` (prod) or .dev.vars (local).
	"vars": {
		"CONTACT_TO": "owner@example.com", // where contact messages & order notifications go
		"EMAIL_FROM": "website@example.com", // must be on a domain you control in Cloudflare/Resend
		"EMAIL_FROM_NAME": "Website",
		"PAYPAL_ENV": "sandbox" // "live" in production
	}

	// Cloudflare Email Routing transport (alternative to RESEND_API_KEY). Requires Email Routing
	// enabled on the domain and CONTACT_TO verified as a destination address.
	// "send_email": [{ "name": "SEND_EMAIL" }],

	// Custom domain (DNS must be on Cloudflare). Replaces GitHub Pages + CNAME file.
	// "routes": [{ "pattern": "example.com", "custom_domain": true }, { "pattern": "www.example.com", "custom_domain": true }]
}
