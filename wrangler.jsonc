// Generated by plugins/prod-branch.js from the repo's wrangler.jsonc on every build. Edit that file, not this one.
{
	"name": "rpb",
	"compatibility_date": "2025-11-01",
	"assets": {
		"directory": ".",
		"binding": "ASSETS",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page",
		"run_worker_first": true
	},
	"observability": {
		"enabled": true
	},
	"workers_dev": false,
	"preview_urls": false,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "rpb",
			"database_id": "bbb4d4f3-df9f-40cc-b692-d264f1ec25cf",
			"migrations_dir": "migrations"
		}
	],
	"vars": {
		"CONTACT_TO": "design@rockpaperbranding.com",
		"EMAIL_FROM": "design@rockpaperbranding.com",
		"EMAIL_FROM_NAME": "Rock, Paper, Branding",
		"PAYPAL_ENV": "sandbox",
		"ACCESS_TEAM_DOMAIN": "rock-paper-branding.cloudflareaccess.com",
		"ACCESS_AUD": "fb06466388ed59b03beba7325c969994b5916bd7949da3227432e42cc7ef8c44",
		"CF_ACCOUNT_ID": "d79ed3e236b5ca1242b59957b84c269a",
		"ACCESS_POLICY_ID": "e1802372-3265-4e7a-98a2-186de50bcdb2",
		"OWNER_EMAILS": "",
		"SUPPORT_EMAIL": "autumnlanewebmaster@gmail.com",
		"PROVIDER_EMAILS": "design@rockpaperbranding.com"
	},
	"routes": [
		{
			"pattern": "rockpaperbranding.com",
			"custom_domain": true
		},
		{
			"pattern": "www.rockpaperbranding.com",
			"custom_domain": true
		}
	],
	"main": "_worker/index.js",
	"no_bundle": true
}
